# =============================================================================
# DouyinLiveRecorder 并发测试专用覆盖率配置（concurrency-test CI job）
# -----------------------------------------------------------------------------
# 用途：CI 的 concurrency-test job（tests/test_concurrency*.py、
# test_async_http_lock.py 等）经 COVERAGE_RCFILE 环境变量指向本文件运行。
# 并发回归测试天然只触及并发相关代码路径，覆盖率远低于全局阈值
# （pyproject.toml [tool.coverage.report].fail_under = 50），故此处
# fail_under = 0（不设下限），仅产出报告用于人工审查。
# 其余配置与 pyproject.toml [tool.coverage.*] 保持一致（source / omit）。
# =============================================================================

[run]
source = src
# 与 pyproject.toml [tool.coverage.run].omit 保持一致（本地工具生成目录同源维护）
omit =
    */tests/*
    */__pycache__/*
    */node/*
    */ffmpeg/*
    */.mimosa/*
    */.qoder/*
    */.agents/*
    */.workbuddy/*
    */.codebuddy/*
    */.trae/*
    */.pnpm-store/*
    */.npm-cache/*
    */.dsh-validation/*
    */.ego-browser-test/*
    */.plugin-src/*
    */.tmp-dps-extract/*
    */pytest-cache-files-*/*

[report]
fail_under = 0
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
